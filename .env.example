# ArkTS Knowledge Graph - Environment Configuration
# Copy this file to .env and fill in your actual values

# Silicon Flow LLM API Configuration
SILICON_FLOW_API_KEY=sk-your-api-key-here
SILICON_FLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICON_FLOW_MODEL=Qwen/Qwen2.5-7B-Instruct

# ArkAnalyzer Configuration
ARKANALYZER_PATH=/path/to/arkanalyzer
ARKTS_SDK_PATH=/path/to/openharmony/sdk

# Database Configuration
DATABASE_PATH=./data/code_knowledge_graph.db

# Web Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# File Watcher Configuration
WATCH_DELAY_SECONDS=2.0
WATCH_PATTERNS=*.ets,*.ts

# Project Configuration
TARGET_PROJECT_PATH=/path/to/your/arkts/project
